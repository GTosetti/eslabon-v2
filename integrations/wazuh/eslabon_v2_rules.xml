<!--
  Eslabon v2 rules for the Wazuh manager (4.14).
  Install as /var/ossec/etc/rules/eslabon_v2_rules.xml (see README.md).

  IDs 100300-100399, group eslabon_v2. Eslabon v1 (100100-100170, group
  eslabon, file eventos.jsonl) is never touched. eslabon_v2 comes only from
  the enclosing <group>; repeating it per rule duplicates it in rule.groups.

  Wazuh emits ONE alert per event, so every event reaches exactly one leaf:
    100300 (level 0, parent: json + events.jsonl + event.module)
      100301-100306  one finding rule per ESL rule (level/mitre = catalog.toml)
      100310         scan summary, status ok      (level 3)
      100311         scan summary, any other status (level 7)
  100306 is also the hand translation of the Sigma rule
  integrations/sigma/eslabon_v2_known_malicious.yml (see MAPPING.md).

  <location> is OS_Match (literal suffix compare, no escapes): it matches
  both /var/log/eslabon/events.jsonl and the agent form
  "(kali) any->/var/log/eslabon/events.jsonl", and not v1's eventos.jsonl.
  Every <field> is type="pcre2" so "\." is a literal dot (in the default
  OS_Regex it would match any character).

  rule.id / rule.name below are OUR decoded JSON fields (data.rule.* in the
  alert), not Wazuh's own rule.id. Generated by hand; tests/test_integrations.py
  checks levels and mitre IDs against src/eslabon/catalog.toml (wazuh_mitre:
  100303 carries T1027, because Wazuh's MITRE db has no T1027.013).
-->
<group name="eslabon_v2,">

  <rule id="100300" level="0">
    <decoded_as>json</decoded_as>
    <location>events.jsonl$</location>
    <field name="event.module" type="pcre2">^eslabon$</field>
    <description>Eslabon v2: event from events.jsonl</description>
  </rule>

  <rule id="100301" level="11">
    <if_sid>100300</if_sid>
    <field name="event.dataset" type="pcre2">^eslabon\.finding$</field>
    <field name="rule.id" type="pcre2">^ESL-001$</field>
    <description>Eslabon v2: ESL-001 $(rule.name) in package $(package.name) ($(eslabon.evidence.file))</description>
    <mitre>
      <id>T1546.016</id>
      <id>T1059.006</id>
    </mitre>
    <group>supply_chain,</group>
  </rule>

  <rule id="100302" level="11">
    <if_sid>100300</if_sid>
    <field name="event.dataset" type="pcre2">^eslabon\.finding$</field>
    <field name="rule.id" type="pcre2">^ESL-002$</field>
    <description>Eslabon v2: ESL-002 $(rule.name) in package $(package.name) ($(eslabon.evidence.file))</description>
    <mitre>
      <id>T1546.016</id>
      <id>T1059.007</id>
    </mitre>
    <group>supply_chain,</group>
  </rule>

  <rule id="100303" level="12">
    <if_sid>100300</if_sid>
    <field name="event.dataset" type="pcre2">^eslabon\.finding$</field>
    <field name="rule.id" type="pcre2">^ESL-003$</field>
    <description>Eslabon v2: ESL-003 $(rule.name) in package $(package.name) ($(eslabon.evidence.file))</description>
    <mitre>
      <id>T1027</id>
      <id>T1140</id>
    </mitre>
    <group>supply_chain,</group>
  </rule>

  <rule id="100304" level="12">
    <if_sid>100300</if_sid>
    <field name="event.dataset" type="pcre2">^eslabon\.finding$</field>
    <field name="rule.id" type="pcre2">^ESL-004$</field>
    <description>Eslabon v2: ESL-004 $(rule.name) in package $(package.name) ($(eslabon.evidence.file))</description>
    <mitre>
      <id>T1552.001</id>
      <id>T1041</id>
    </mitre>
    <group>supply_chain,</group>
  </rule>

  <rule id="100305" level="7">
    <if_sid>100300</if_sid>
    <field name="event.dataset" type="pcre2">^eslabon\.finding$</field>
    <field name="rule.id" type="pcre2">^ESL-005$</field>
    <description>Eslabon v2: ESL-005 $(rule.name) in package $(package.name) ($(eslabon.evidence.snippet))</description>
    <mitre>
      <id>T1195.001</id>
    </mitre>
    <group>supply_chain,</group>
  </rule>

  <!-- Also the hand translation of Sigma f9ae885f-ae92-4240-89f8-f8bc7cc16efb -->
  <rule id="100306" level="13">
    <if_sid>100300</if_sid>
    <field name="event.dataset" type="pcre2">^eslabon\.finding$</field>
    <field name="rule.id" type="pcre2">^ESL-006$</field>
    <description>Eslabon v2: ESL-006 $(rule.name) package $(package.name) $(package.version) (OSV MAL advisory)</description>
    <mitre>
      <id>T1195.001</id>
    </mitre>
    <group>supply_chain,sigma,</group>
  </rule>

  <rule id="100310" level="3">
    <if_sid>100300</if_sid>
    <field name="event.dataset" type="pcre2">^eslabon\.scan$</field>
    <field name="eslabon.scan.status" type="pcre2">^ok$</field>
    <description>Eslabon v2: scan of $(package.name) complete, $(eslabon.scan.findings) finding(s)</description>
    <group>scan_summary,</group>
  </rule>

  <rule id="100311" level="7">
    <if_sid>100300</if_sid>
    <field name="event.dataset" type="pcre2">^eslabon\.scan$</field>
    <field name="eslabon.scan.status" type="pcre2" negate="yes">^ok$</field>
    <description>Eslabon v2: scan of $(package.name) NOT complete, status $(eslabon.scan.status)</description>
    <group>scan_summary,</group>
  </rule>

</group>
